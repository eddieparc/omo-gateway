+                "enabled": true
+            },
+            {
+                "id": "restart",
+                "name": "Forbidden Lifecycle Job",
+                "prompt": "hermes gateway restart",
+                "schedule": {
+                    "kind": "cron",
+                    "expr": "0 9 * * *"
