+        .find(|p| p.to_string_lossy().contains(".bak-omon-migration-"))
+        .unwrap();
+    assert_eq!(fs::read(&cron_backup).unwrap(), JOBS.as_bytes());
+    for path in [
+        root.join("gateway.env"),
