+    // 2. "restart" - forbidden gateway lifecycle prompt
+    // 3. "standup" - valid job with valid schedule expression
+    let work_jobs = serde_json::json!({
+        "jobs": [
+            {
+                "id": "bad",
+                "name": "Bad Schedule Job",
+                "prompt": "echo hello",
+                "schedule": {
+                    "kind": "cron"
