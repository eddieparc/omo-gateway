+            .map_err(|e| OmonError::Config(format!("failed to serialize empty store: {e}")))?;
+    let emptied_hash = sha256_hex(&emptied);
+
+    for (_profile, store_path_str, orig_hash, repl_hash, backup_path, _phase) in &stores {
+        let path = PathBuf::from(store_path_str);
+        let current_bytes = if env.exists(&path) {
+            env.read(&path)?
+        } else {
+            Vec::new()
+        };
+        let current_hash = sha256_hex(&current_bytes);
+
+        if current_hash == *repl_hash || current_hash == emptied_hash {
+            sqlx::query(
+                "UPDATE cron_cutover_receipt_stores SET phase = 'replaced', updated_at = ? WHERE operation_id = ? AND store_path = ?",
+            )
